---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro'

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'NanoScripts — Automated QA infrastructure',
	description = 'We set up Playwright test suites, Docker environments, and GitHub Actions for web applications.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ffffff" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-white font-sans text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
		<slot />
	</body>
</html>
